/dts-v1/;

#include "rk3566-powkiddy-rk2023.dts"

/ {
	compatible = "powkiddy,rgb20-pro", "rockchip,rk3566";
	model = "Powkiddy RGB20 Pro";

	/*
	 * Crash and console log kept in RAM across a warm reset (read back from /sys/fs/pstore).
	 * 256 MiB in sits clear of where U-Boot loads the kernel, device tree and initramfs
	 * (0x00280000 to about 0x0b000000) and of U-Boot's own copy at the top of RAM.
	 */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		ramoops@10000000 {
			compatible = "ramoops";
			reg = <0x0 0x10000000 0x0 0x100000>;
			console-size = <0x80000>;
			record-size = <0x10000>;
		};
	};

	/*
	 * The left stick's vertical axis reads higher towards the bottom; the input convention (and
	 * games) want up to be negative.
	 */
	adc-joystick {
		axis@2 {
			abs-range = <800 250>;
		};
	};

	vibrator: pwm-vibrator {
		compatible = "pwm-vibrator";
		pwm-names = "enable";
		pwms = <&pwm5 0 1000000000 0>;
	};

};

&battery {
	charge-full-design-microamp-hours = <5000000>;
	factory-internal-resistance-micro-ohms = <110000>;
	voltage-max-design-microvolt = <4148000>;
	voltage-min-design-microvolt = <3500000>;

	ocv-capacity-table-0 =  <4148000 100>, <4076000 95>, <4056000 90>, <4041000 85>,
				<4030000 80>, <4015000 75>, <3993000 70>, <3964000 65>,
				<3929000 60>, <3889000 55>, <3864000 50>, <3846000 45>,
				<3827000 40>, <3806000 35>, <3780000 30>, <3740000 25>,
				<3687000 20>, <3636000 15>, <3592000 10>, <3548000 5>,
				<3500000 0>;
};

/* VPLL is left to follow the panel's pixel clock (dclk_vop1), so every mode gets its own rate. */
&cru {
	assigned-clocks = <&pmucru CLK_RTC_32K>, <&cru PLL_GPLL>, <&pmucru PLL_PPLL>;
	assigned-clock-rates = <32768>, <1200000000>, <200000000>;
};

/*
 * The panel's DSI link shows a clean picture only near a 51 MHz pixel clock: at 54.6 MHz its colours
 * shift, from about 59.8 MHz it fades into vertical bands. So 59.73 Hz (GBA), 59.94 Hz and 60.10 Hz
 * (NTSC consoles) run at 51.03, 51.09 and 51.16 MHz with longer or shorter blanking, as the 50 Hz
 * and 57.5 Hz modes do; ROCKNIX's versions of those three ran at 62.93, 59.84 and 54.6 MHz. The
 * 75.47, 90 and 120 Hz modes need faster clocks and don't show a clean picture.
 */
&dsi0 {
        panel: panel@0 {
		compatible = "rocknix,generic-dsi";
		panel_description =
			"G size=65,49 delays=200,150,36,36,20 format=rgb888 lanes=4 flags=0xe03",

			"M clock=51072 horizontal=1024,20,4,20 vertical=768,15,3,11 default=1",
			"M clock=51312 horizontal=1024,20,30,20 vertical=768,15,145,11",
			"M clock=51072 horizontal=1024,20,56,20 vertical=768,15,118,11",
			"M clock=52162 horizontal=1024,20,54,20 vertical=768,15,139,11",
			"M clock=51152 horizontal=1024,20,48,20 vertical=768,15,6,11",
			"M clock=51031 horizontal=1024,20,4,20 vertical=768,18,3,11",
			"M clock=51085 horizontal=1024,20,4,20 vertical=768,16,3,11",
			"M clock=51312 horizontal=1024,20,5,20 vertical=768,15,6,11",
			"M clock=51155 horizontal=1024,20,4,20 vertical=768,15,3,11",
			"M clock=65390 horizontal=1024,20,15,20 vertical=768,15,9,11",
			"M clock=77040 horizontal=1024,20,6,20 vertical=768,15,6,11",
			"M clock=102720 horizontal=1024,20,6,20 vertical=768,15,6,11",

			"I seq=df9168f9",
			"I seq=de00",
			"I seq=b2007e",
			"I seq=b3007e",
			"I seq=c1001000000000",
			"I seq=bb02240761194444",
			"I seq=be1af2",
			"I seq=c310175a175a0505050515153105df",
			"I seq=c4118000df090614",
			"I seq=ce0003030303030303030303030303030303030303030f03",
			"I seq=cf00014001ca01ca01ca",
			"I seq=d0001f1f1f1f1f1f1f1f1f1f03010507090b1e151f1f151f",
			"I seq=d1001f1f1f1f1f1f1f1f1f1f02000406080a1e151f1f151f",
			"I seq=d2001f1f1f1f1f1f1f1f1f1f00020a0806041f151f1f151e",
			"I seq=d3001f1f1f1f1f1f1f1f1f1f01030b0907051f151f1f151e",
			"I seq=d43000000400060000000000030300110001c0040101118001c00501010000000400061802e3",
			"I seq=d56873000808000300",
			"I seq=b700d80000d800",
			"I seq=c87f695a4e4a3b402a4443446351594c483a280f7f695a4e4a3b402a4443446351594c483a280f",
			"I seq=de02",
			"I seq=bb005b5c41",
			"I seq=b5005a0a",
			"I seq=c622",
			"I seq=d712",
			"I seq=de00",
			"I seq=3500",
			"I seq=11 wait=250",
			"I seq=29 wait=250";
        };
};

&pwm5 {
	status = "okay";
};
